# Maintainer: gencayks
pkgname=cheese-git
pkgver=2.0.0.r1210.b1572f1
pkgrel=1
pkgdesc="Cheese — Linux-first web panel for configuring supported mice over WebHID"
arch=('any')
url="https://github.com/gencayks/openmouse"
license=('AGPL-3.0-or-later')
depends=('python' 'xdg-utils')
makedepends=('nodejs' 'npm')
optdepends=('chromium: WebHID-capable browser for the panel')
conflicts=('openmouse-git')
replaces=('openmouse-git')
source=("${pkgname}::git+${url}.git#branch=main")
sha256sums=('SKIP')
install=cheese.install

pkgver() {
  cd "${pkgname}"
  printf "2.0.0.r%s.%s" "$(git rev-list --count HEAD)" "$(git rev-parse --short HEAD)"
}

build() {
  cd "${pkgname}"
  npm ci --no-audit --no-fund
  npm run build
}

package() {
  cd "${pkgname}"
  install -dm755 "${pkgdir}/usr/share/cheese"
  cp -r dist/. "${pkgdir}/usr/share/cheese/"
  install -Dm644 udev/70-cheese.rules "${pkgdir}/usr/lib/udev/rules.d/70-cheese.rules"
  install -Dm755 distro/aur/cheese.sh "${pkgdir}/usr/bin/cheese"
  install -Dm644 distro/aur/cheese.desktop "${pkgdir}/usr/share/applications/cheese.desktop"
  install -Dm644 dist/icon-512.png "${pkgdir}/usr/share/icons/hicolor/512x512/apps/cheese.png"
  install -Dm644 LICENSE "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
}
